<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure C# console tests for the world generator (world only; nations are covered by SimTests). Lives outside game/ so Godot doesn't compile it.
       Compiles the generator sources straight from the game project; override with -p:GameDir=<path to a game copy>/ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)../../game/</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GameDir)scripts/Core/Noise.cs" Link="Game/Core/Noise.cs" />
    <Compile Include="$(GameDir)scripts/Core/Data.cs" Link="Game/Core/Data.cs" />
    <!-- Data.Nation carries a FlagSpec -->
    <Compile Include="$(GameDir)scripts/Core/Flags/FlagSpec.cs;$(GameDir)scripts/Core/Flags/FlagPatterns.cs" Link="Game/Core/Flags/%(Filename)%(Extension)" />
    <Compile Include="$(GameDir)scripts/World/**/*.cs" Link="Game/World/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- golden per-array hashes of the last blessed generator: rewritten by running with the bless flag -->
    <None Include="reference/*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="reference" />
  </ItemGroup>
</Project>
